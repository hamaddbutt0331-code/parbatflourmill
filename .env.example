# Copy this file to .env for running on your own computer. On Render, enter these in the Environment tab instead.
# Free Postgres database from neon.tech (Connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Google Maps JavaScript API key (restrict it to your website address in Google Cloud)
GOOGLE_MAPS_API_KEY=
# Your website address (no trailing slash). On Render this is filled in automatically if left empty.
BASE_URL=
# First admin account (created on first start). Password: 10+ characters.
ADMIN_USER=admin
ADMIN_PASSWORD=
NODE_ENV=production
