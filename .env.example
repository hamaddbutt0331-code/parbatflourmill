# Copy this file to .env and fill in the values.
PORT=3000
NODE_ENV=production
# Your website address, used for SEO links and the sitemap (no trailing slash)
BASE_URL=https://www.example.com
# Google Maps JavaScript API key (restrict it to your domain in Google Cloud Console)
GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud for custom map styling
GOOGLE_MAP_ID=
# First admin account, created on the first start only. Use a strong password (10+ characters).
ADMIN_USER=admin
ADMIN_PASSWORD=
# Folder for the database file (keep it on a persistent disk)
DATA_DIR=./data
# Set to true when running behind a proxy such as Nginx, Cloudflare or Render
TRUST_PROXY=true
